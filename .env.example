# Copy to .env and fill in from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
# Optional: register commands to a single guild instantly (recommended while testing)
GUILD_ID=
# Optional: serve character token art from somewhere else. Must end in a slash;
# files are looked up as <base><role-id>.png. Defaults to the clocktower.online
# source repo.
ICON_BASE_URL=
# Optional: same idea for the shared art (token.png, shroud.png). Must end in a
# slash.
ASSET_BASE_URL=
